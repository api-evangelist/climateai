{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClimateAI Platform Report API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets all accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/report/"
          },
          "docs": "Gets all accounts"
        },
        {
          "info": {
            "name": "Creates a new report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/report/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new report"
        },
        {
          "info": {
            "name": "Gets a specific account by its id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/report/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Gets a specific account by its id"
        },
        {
          "info": {
            "name": "Disables an account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/report/:report_id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Disables an account"
        }
      ]
    }
  ],
  "bundled": true
}