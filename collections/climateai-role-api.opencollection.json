{
  "opencollection": "1.0.0",
  "info": {
    "name": "ClimateAI Platform Role API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "role",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/role/"
          }
        },
        {
          "info": {
            "name": "Creates a new Role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/role/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new Role"
        },
        {
          "info": {
            "name": "fetch a role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/role/:role_id",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "The role id"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Updates a role",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/role/:role_id",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "The role id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a role"
        },
        {
          "info": {
            "name": "Deletes a role by id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/role/:role_id",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "The role id"
              }
            ]
          },
          "docs": "Deletes a role by id"
        },
        {
          "info": {
            "name": "Adds a new Role/Permission association",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/role/:role_id/permission/:permission_id",
            "params": [
              {
                "name": "permission_id",
                "value": "",
                "type": "path",
                "description": "The permission id"
              },
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "The role id"
              }
            ]
          },
          "docs": "Adds a new Role/Permission association"
        },
        {
          "info": {
            "name": "Removes a Role/Permission association",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/role/:role_id/permission/:permission_id",
            "params": [
              {
                "name": "permission_id",
                "value": "",
                "type": "path",
                "description": "The permission id"
              },
              {
                "name": "role_id",
                "value": "",
                "type": "path",
                "description": "The role id"
              }
            ]
          },
          "docs": "Removes a Role/Permission association"
        }
      ]
    }
  ],
  "bundled": true
}